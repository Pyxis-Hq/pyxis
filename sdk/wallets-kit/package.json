{
  "name": "@pyxis-hq/wallets-kit",
  "version": "0.1.0-beta.1",
  "description": "Privacy-first wallet analytics SDK for Stellar and Soroban dApps. Track wallet connect, sign and submit funnels as counts only, with no addresses or signatures. React and vanilla JS, zero dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stellar",
    "soroban",
    "stellar-wallets-kit",
    "stellar-analytics",
    "freighter",
    "xbull",
    "albedo",
    "lobstr",
    "wallet",
    "wallet-analytics",
    "wallet-funnel",
    "funnel",
    "analytics",
    "privacy",
    "privacy-first",
    "web3",
    "dapp",
    "sdk",
    "react",
    "typescript",
    "pyxis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pyxis-Hq/pyxis.git",
    "directory": "sdk/wallets-kit"
  },
  "bugs": "https://github.com/Pyxis-Hq/pyxis/issues",
  "homepage": "https://docs.usepyxis.xyz/docs/guides/wallet-funnel",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  }
}
