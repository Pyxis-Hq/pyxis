{
  "name": "@pyxis-hq/wallets-kit",
  "version": "0.1.0-beta.0",
  "description": "Privacy-first wallet funnel analytics for Stellar dApps. Counts only: no addresses, signatures or free text.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stellar",
    "soroban",
    "analytics",
    "wallet",
    "privacy",
    "pyxis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pyxis-Hq/pyxis.git",
    "directory": "sdk/wallets-kit"
  },
  "bugs": "https://github.com/Pyxis-Hq/pyxis/issues",
  "homepage": "https://github.com/Pyxis-Hq/pyxis/tree/main/sdk/wallets-kit#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
